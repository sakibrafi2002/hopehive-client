# URL of the Express API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# BetterAuth. BETTER_AUTH_URL must be the public URL of THIS Next.js app.
# The server's AUTH_BASE_URL must be exactly the same value, because it is used as the JWT issuer and audience.
BETTER_AUTH_URL=http://localhost:3000
# Generate one with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Same MongoDB cluster as the server is fine. BetterAuth stores users, sessions and keys in its own collections.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hopehive?retryWrites=true&w=majority

# Google sign-in (optional but recommended). Authorised redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
